# Line ending dinormalkan agar working copy tidak terus terlihat "berubah"
# setelah commit: isi file identik, tapi git akan menandainya modified karena
# checkout menulis CRLF di Windows sementara repository menyimpan LF.
* text=auto eol=lf

*.blade.php text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.php      text eol=lf
*.vue      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Biner: jangan pernah disentuh normalisasi line ending.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip  binary
*.sql  binary

# Lockfile ikut LF supaya diff-nya tidak seluruhnya berubah.
pnpm-lock.yaml text eol=lf