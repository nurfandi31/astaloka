# Backend ASTALOKA untuk dev server Vite.
#
# Vhost Laragon sudah diarahkan ke `backend/public`, jadi backend hidup di
# root domain dan tidak perlu path `/backend/public` lagi.
#
# Nilai ini hanya jadi TARGET PROXY Vite. Base URL axios sengaja TIDAK
# memakainya -- lihat `VITE_API_BASE_URL` di bawah.
VITE_BACKEND_URL=http://astaloka.test

# Base URL API untuk axios. KOSONGKAN di development.
#
# Kalau diisi, axios absolut ke URL ini dan subdomain lokasi yang sedang
# dibuka ikut hilang: SPA di `demo.astaloka.test:5173` akan fetching ke host
# pusat, dan `/api/branding` membalas branding bawaan.
#
# Kosong = axios memakai origin sendiri (`window.location`), jadi subdomain
# yang sedang dibuka tetap ikut terbawa -- sama seperti produksi.
VITE_API_BASE_URL=