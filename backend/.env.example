APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astaloka_lokasi
DB_USERNAME=root
DB_PASSWORD=

# === Tenancy ASTALOKA ===
# DB_DATABASE = database LOKASI aktif. Diisi ulang tiap request oleh
# TenantManager berdasarkan baris `tenants` di database pusat.
# Nilai di atas hanya fallback saat tidak ada tenant yang ter-resolve.
#
# Pusat = `astaloka` (nama polos). Lokasi = `astaloka_<nama-lokasi>`,
# mis. `astaloka_lokasi`, `astaloka_pamsimas`.
TENANCY_CENTRAL_DATABASE=astaloka

# 'host' = produksi (subdomain per lokasi), 'slug' = lokal (header/body).
TENANCY_LOOKUP=host

# URL SPA. Hanya perlu diisi saat SPA dilayani dari host/port berbeda dari
# backend (development dengan Vite dev server). Kosongkan di produksi.
#
# Di development JANGAN diisi `http://localhost:5173`. Nilai itu membuang
# subdomain yang dipakai petugas: `demo.astaloka.test` dilempar ke
# `localhost`, backend tidak bisa mencocokkan tenant, dan `/api/branding`
# membalas branding BAWAAN -- padahal panel pusat sudah menyimpan teks dan
# warnanya dengan benar. Semua lokasi yang dibuka lewat `localhost` juga jadi
# tampil sama persis, jadi tidak ada bedanya lokasi 1 dengan yang lain.
#
# Isi `frontend_url_template` (baris di bawah) sebagai gantinya.
TENANCY_FRONTEND_URL=http://localhost:5173

# Redirect `/` di subdomain lokasi memakai host yang SEDANG diakses, dengan
# `{host}` diganti host request.
#
# Dev : http://{host}:5173
# Prod: KOSONGKAN. Path relatif `/login` sudah benar di produksi, dan nilai
#       template tidak boleh dipakai karena panel pusat tidak punya subdomain.
TENANCY_FRONTEND_URL_TEMPLATE=http://{host}:5173

# === Akun Demo per Lokasi ===
# Saat lokasi baru didaftarkan dari panel pusat, empat akun contoh dibuat
# otomatis di database lokasi itu, satu untuk setiap role:
#
#   admin@gmail.com / pelanggan@gmail.com / surveyor@gmail.com /
#   teknisi@gmail.com   --> semua password `password`
#
# Set `TENANCY_DEMO_USERS=false` di produksi. Password `password` yang aktif
# di setiap lokasi produksi bukan sandaran yang layak, dan cost-nya nol:
# lokasi yang dibuat sesudah sakelar ini mati tidak ikut mendapat akun demo.
#
# Password bisa diganti lewat `TENANCY_DEMO_USERS_PASSWORD`. Email TIDAK bisa
# diganti dari .env -- mengubah email berarti email yang diketik saat login
# tidak lagi sama dengan email yang jadi kunci idempotensi seeder.
TENANCY_DEMO_USERS=true
TENANCY_DEMO_USERS_PASSWORD=password

# === Login Pintasan (/login/user) ===
# Halaman yang menampilkan user LOKASI INI saja -- lokasi yang sedang
# melayani request, ditentukan oleh subdomain (atau slug saat
# TENANCY_LOOKUP=slug) -- dan bisa langsung masuk sebagai salah satunya TANPA
# password. Endpoint-nya sengaja tidak butuh autentikasi -- itulah
# fungsinya -- jadi siapa pun yang tahu URL-nya bisa mendapat token untuk
# user mana pun DI LOKASI ITU, termasuk admin.
#
# Catatan penting untuk produksi: yang dilindungi endpoint ini adalah lokasi
# tempat request sampai, bukan identitas pemanggil. Kalau `TENANCY_LOOKUP=host`,
# setiap subdomain lokasi punya pintasan login-nya sendiri -- dan pintasan itu
# hanya melihat akun lokasi tersebut. Jangan pernah memakai
# `TENANCY_LOOKUP=slug` di produksi: tanpa subdomain, semua permintaan ikut
# dilayani satu lokasi dan daftar pintasan ikut terbuka untuk domain apa pun.
#
# Kalau baris di bawah DIHAPUS dari .env, nilainya tidak `true` di
# APP_ENV=production: halaman dan endpoint membalas 404. Sakelarnya harus
# diaktifkan eksplisit di produksi kalau memang mau dipakai.
#
# Tampilkan teks password apa adanya HANYA kalau password user cocok dengan
# salah satu password demo di bawah. Password yang sudah diganti user tidak
# bisa ditampilkan, karena kolomnya menyimpan hash bcrypt yang satu arah.
# Nilai ini mengikuti aturan yang sama: default-nya nonaktif di produksi.
#
# Detail lengkapnya ada di config/shortcut_login.php.
SHORTCUT_LOGIN_ENABLED=true
SHORTCUT_LOGIN_REVEAL_PASSWORD=true
SHORTCUT_LOGIN_DEMO_PASSWORDS=password,rahasia123,legacy
# Berapa banyak user lokasi yang ditampilkan. Tidak perlu diisi kalau 100 cukup.
# SHORTCUT_LOGIN_PER_LOCATION_LIMIT=100

# === Koneksi DB LAMA (server SIM SPPG) ===
# Sumber: server 103.177.95.92 (Almalinux SIM-SPPG)
# Dipakai khusus oleh Artisan Command untuk import data.
# JANGAN di-commit ke git. Isi hanya di file .env lokal.
#
# PENTING: nama database legacy TIDAK BOLEH sama dengan `astaloka`, karena
# `astaloka` sekarang adalah database PUSAT. Kalau dibiarkan sama, import
# akan membaca tabel yang tidak ada di pusat. Kosongkan kalau tidak dipakai.
#
# !! PENTING - password WAJIB dibungkus tanda kutip tunggal !!
# Password DB legacy mengandung karakter '#'. Tanpa kutip, '#' dibaca sebagai
# awal komentar sehingga password TERPOTONG di tengah (mis. 22 karakter jadi 17).
# Gejalanyaoze Access denied yang MENYESATKAN, padahal host/user sudah benar.
#   SALAH:  LEGACY_DB_PASSWORD=abc#def#ghi   -> terbaca hanya "abc"
#   BENAR:  LEGACY_DB_PASSWORD='abc#def#ghi' -> utuh
# Gejalanya: Access denied yang MENYESATKAN, padahal host/user sudah benar.
#   SALAH:  LEGACY_DB_PASSWORD=abc#def#ghi   -> terbaca hanya "abc"
#   BENAR:  LEGACY_DB_PASSWORD='abc#def#ghi' -> utuh
# Verifikasi: php artisan legacy:check
LEGACY_DB_HOST=103.177.95.92
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=astaloka_lama
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_SOCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
